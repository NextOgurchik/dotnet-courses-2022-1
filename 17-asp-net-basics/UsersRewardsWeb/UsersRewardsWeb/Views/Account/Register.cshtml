@model UsersRewardsWeb.Models.RegisterViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Регистрация";
}

<h2>📝 Регистрация</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">❌ @TempData["ErrorMessage"]</div>
}

<form method="post" action="/Account/Register" id="registerForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Имя пользователя -->
    <div class="form-group mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <!-- Email -->
    <div class="form-group mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <!-- Пароль -->
    <div class="form-group mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <!-- Подтверждение пароля -->
    <div class="form-group mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <!-- ⚡ КАПЧА (ПРОСТОЙ ВАРИАНТ) ⚡ -->
    <div class="form-group mb-3">
        <label class="form-label">Капча</label>
        <div style="display: flex; align-items: center; gap: 15px; background: #f8f9fa; padding: 10px; border-radius: 5px;">
            <strong id="captchaDisplay" style="font-size: 1.4rem;">@Model.CaptchaExpression</strong>
            <input type="text" id="CaptchaAnswer" name="CaptchaAnswer" class="form-control" style="width: 100px;" placeholder="Ответ" />
            <button type="button" id="refreshCaptcha" class="btn btn-secondary btn-sm">🔄</button>
        </div>
        <span asp-validation-for="CaptchaAnswer" class="text-danger"></span>

        <!-- ПЕРЕДАЁМ CaptchaResult ЯВНО (БЕЗ asp-for) -->
        <input type="hidden" id="CaptchaResult" name="CaptchaResult" value="@Model.CaptchaResult" />
    </div>

    <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
</form>

<div class="mt-3">
    Уже есть аккаунт? <a asp-action="Login">Войти</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const refreshBtn = document.getElementById('refreshCaptcha');
            const captchaDisplay = document.getElementById('captchaDisplay');
            const captchaResult = document.getElementById('CaptchaResult');
            const captchaAnswer = document.getElementById('CaptchaAnswer');

            // ===== ОБНОВЛЕНИЕ КАПЧИ =====
            refreshBtn.addEventListener('click', function() {
                fetch('/Account/RefreshCaptcha')
                    .then(res => res.json())
                    .then(data => {
                        captchaDisplay.textContent = data.expression;
                        captchaResult.value = data.result;  // ← ОБНОВЛЯЕМ
                        captchaAnswer.value = '';
                    })
                    .catch(err => {
                        console.error('Ошибка обновления капчи:', err);
                    });
            });

            // ===== КЛИЕНТСКАЯ ПРОВЕРКА =====
            document.getElementById('registerForm').addEventListener('submit', function(e) {
                const userAnswer = captchaAnswer.value.trim();
                const expectedResult = captchaResult.value;

                if (userAnswer === '') {
                    alert('Введите ответ капчи!');
                    e.preventDefault();
                    return false;
                }

                if (userAnswer !== expectedResult) {
                    alert('Неверный ответ капчи!');
                    e.preventDefault();
                    return false;
                }

                return true;
            });
        });
    </script>
}