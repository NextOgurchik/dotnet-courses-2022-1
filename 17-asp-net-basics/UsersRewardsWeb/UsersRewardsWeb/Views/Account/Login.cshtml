@model UsersRewardsWeb.Models.LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<h2>Вход в систему</h2>

<!-- ========== УВЕДОМЛЕНИЕ ОБ УСПЕШНОЙ РЕГИСТРАЦИИ ========== -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-left: 5px solid #28a745; background-color: #d4edda;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 2rem;">✅</span>
            <div>
                <strong style="font-size: 1.1rem;">Регистрация прошла успешно!</strong>
                <p style="margin: 0; color: #155724;">@TempData["SuccessMessage"]</p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ========== ФОРМА ВХОДА ========== -->
<form asp-action="Login" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" placeholder="Введите имя пользователя" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" type="password" placeholder="Введите пароль" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary w-100">Войти</button>
</form>

<div class="mt-3 text-center">
    Нет аккаунта? <a asp-action="Register">Зарегистрироваться</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}